{
  "variable": {
    "extra": {
      "type": "number",
      "default": 5
    }
  },
  "run": {
    "uses_test_variable": {
      "command": "plan",
      "variables": {
        "len": "${var.extra}"
      },
      "assert": [
        {
          "condition": "${random_string.s.length == 5}",
          "error_message": "len should come from the test-file variable"
        }
      ]
    }
  }
}
